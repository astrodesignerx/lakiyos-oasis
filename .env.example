# Lakiyo's Oasis (YOASIS) — Environment Variables

# Neon Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Clerk Auth (keyless mode — no keys needed initially)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend Email
RESEND_API_KEY=
FROM_EMAIL=Lakiyo's Oasis <lakiyooasis@gmail.com>

# Paystack (M-Pesa + Card Payments)
PAYSTACK_SECRET_KEY=

# WhatsApp (your business number)
NEXT_PUBLIC_WHATSAPP_NUMBER=+254700000000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3003

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Admin dashboard access (comma-separated email allowlist)
ADMIN_EMAILS=
